---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolShell from '~/components/ToolShell.astro';
import Base64ImageTool from '~/components/tools/Base64ImageTool';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { buildDict } from '~/lib/dict';
import { buildToolJsonLd } from '~/lib/seo';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h1 = t('t.b64img.title');
const lead = t('t.b64img.lead');
const metaTitle = t('seo.b64img.title');
const metaDesc = t('seo.b64img.description');
const keywords = t('seo.b64img.keywords');

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');
const url = `${SITE}${Astro.url.pathname.replace(/\/$/, '')}`;
const homePath = lang === 'en' ? withBase('/') : withBase('/es/');
const jsonLd = buildToolJsonLd({ name: h1, description: lead, url, lang }, SITE, homePath);

const dict = buildDict(lang, [
  'ui.copy',
  'ui.copied',
  'ui.copyFailed',
  'ui.clear',
  't.b64img.toB64',
  't.b64img.toImg',
  't.b64img.dropImage',
  't.b64img.dataUrlPlaceholder',
  't.b64img.preview',
  't.b64img.size',
] as const);
---

<BaseLayout title={metaTitle} description={metaDesc} {keywords} {jsonLd}>
  <ToolShell title={h1} {lead}>
    <Base64ImageTool client:only="react" dict={dict} />
  </ToolShell>
</BaseLayout>
