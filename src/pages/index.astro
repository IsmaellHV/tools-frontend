---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolCard from '~/components/ToolCard.astro';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { TOOLS, CATEGORIES, toolsByCategory } from '~/lib/tools';

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = t('home.metaTitle');
const description = t('home.metaDescription');
const keywords =
  lang === 'en'
    ? 'developer tools, online tools, base64, qr code, json viewer, json to excel, aes encrypt, jwt decoder, compare text, pdf tools, image tools, free dev utilities'
    : 'herramientas desarrollo, utilidades online, base64, codigo qr, visor json, json a excel, cifrar aes, decodificador jwt, comparar texto, herramientas pdf, dev tools gratis';

const langPrefix = lang === 'en' ? '' : '/es';
const toolHref = (slug: string) => withBase(`${langPrefix}/${slug}`);
const toolUrl = (slug: string) => `${SITE}${toolHref(slug)}`;
const homeUrl = `${SITE}${withBase(langPrefix === '' ? '/' : '/es/')}`;

const visibleCats = CATEGORIES.filter((c) => toolsByCategory(c.id).length > 0);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'DevTools',
    url: homeUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript and a modern browser',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
    inLanguage: lang,
    publisher: { '@type': 'Person', name: 'ismaelhv', url: 'https://ismaelhv.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: lang === 'es' ? 'Herramientas para desarrolladores' : 'Developer tools',
    numberOfItems: TOOLS.length,
    itemListElement: TOOLS.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t(tool.titleKey),
      description: t(tool.bodyKey),
      url: toolUrl(tool.slug),
    })),
  },
];
---

<BaseLayout {title} {description} {keywords} {jsonLd}>
  <section class="mb-7 grid gap-6 md:grid-cols-[1.6fr_1fr] md:items-center">
    <div>
      <p class="tag mb-3">// {String(TOOLS.length).padStart(2, '0')} TOOLS · v1.0</p>
      <h1 class="text-3xl leading-[0.95] md:text-5xl">
        {t('home.heroPre')}<br />
        <span style="background: var(--color-accent); color: var(--color-accent-fg); padding: 0 0.3em; display: inline-block">
          {t('home.heroAccent')}
        </span>{t('home.heroDot')}
      </h1>
      <p class="mt-4 max-w-xl text-sm" style="color: var(--color-fg-muted)">
        {t('home.heroLead')}
      </p>
    </div>
    <ul class="card space-y-1 text-xs" style="background: var(--color-bg-raised); padding: 0.9rem 1rem">
      <li>→ {t('home.manifesto1')}</li>
      <li>→ {t('home.manifesto2')}</li>
      <li>→ {t('home.manifesto3')}</li>
      <li>→ {t('home.manifesto4')}</li>
    </ul>
  </section>

  <div class="divider"></div>

  <div class="mb-6 flex flex-col gap-3">
    <div class="flex items-stretch gap-3">
      <div style="position: relative; flex: 1; display: flex; align-items: center">
        <span aria-hidden="true" style="position: absolute; left: 0.7rem; color: var(--color-fg-muted); font-family: var(--font-mono); pointer-events: none">⌕</span>
        <input
          id="tool-search"
          type="search"
          autocomplete="off"
          placeholder={t('home.searchPlaceholder')}
          aria-label={t('home.searchPlaceholder')}
          style="padding-left: 2rem; padding-right: 2.6rem"
        />
        <span class="kbd" id="search-hint" aria-hidden="true" style="position: absolute; right: 0.6rem; pointer-events: none">/</span>
      </div>
      <div class="tag" style="display: flex; align-items: center; white-space: nowrap">
        <span id="tool-count" style="color: var(--color-accent); font-weight: 700">{TOOLS.length}</span>&nbsp;/ {TOOLS.length} {t('home.toolsLabel')}
      </div>
    </div>

    <div id="tool-chips" class="flex flex-wrap gap-2">
      <button type="button" class="chip is-active" data-cat="all" aria-pressed="true">
        {t('home.filterAll')} <span class="chip-n">{TOOLS.length}</span>
      </button>
      {
        visibleCats.map((cat) => (
          <button type="button" class="chip" data-cat={cat.id} aria-pressed="false">
            {t(cat.titleKey)} <span class="chip-n">{toolsByCategory(cat.id).length}</span>
          </button>
        ))
      }
    </div>
  </div>

  <section id="recent-section" class="mb-8" hidden>
    <div class="sec-head">
      <h2 class="label" style="margin-bottom: 0">// {t('home.recent')}</h2>
      <button type="button" id="recent-clear" class="sec-link">{t('home.recentClear')} ✕</button>
    </div>
    <div id="recent-grid" class="tool-grid"></div>
  </section>

  <div id="tool-sections">
    {
      visibleCats.map((cat) => (
        <section class="cat-section mb-8" data-section={cat.id}>
          <div class="sec-head">
            <h2 class="label" style="margin-bottom: 0">// {t(cat.titleKey)}</h2>
            <p class="sec-desc">{t(cat.bodyKey)}</p>
            <span class="font-mono text-xs" style="color: var(--color-fg-muted)">{toolsByCategory(cat.id).length}</span>
          </div>
          <div class="tool-grid">
            {toolsByCategory(cat.id).map((tool) => (
              <ToolCard
                slug={tool.slug}
                href={toolHref(tool.slug)}
                name={t(tool.titleKey)}
                body={t(tool.bodyKey)}
                cat={t(cat.titleKey)}
                catId={cat.id}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <p id="tool-empty" class="mt-6 font-mono text-sm" style="display: none; color: var(--color-fg-muted)">// {t('home.noResults')}</p>
</BaseLayout>

<style>
  .chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.35rem 0.7rem;
    background: var(--color-bg-card);
    color: var(--color-fg);
    border: 2px solid var(--color-border-strong);
    border-radius: 0;
    cursor: pointer;
    transition: transform 0.08s ease;
  }
  .chip:hover {
    transform: translate(-2px, -2px);
  }
  .chip .chip-n {
    color: var(--color-fg-muted);
    margin-left: 0.2rem;
  }
  .chip.is-active {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
  .chip.is-active .chip-n {
    color: var(--color-accent-fg);
  }

</style>

<script>
  const RECENT_KEY = 'tools_recent';
  const RECENT_MAX = 3; // una fila exacta en la grilla de 3 columnas

  const sections = Array.from(document.querySelectorAll<HTMLElement>('.cat-section'));
  const chips = Array.from(document.querySelectorAll<HTMLElement>('#tool-chips .chip'));
  const search = document.getElementById('tool-search') as HTMLInputElement | null;
  const hint = document.getElementById('search-hint');
  const countEl = document.getElementById('tool-count');
  const emptyEl = document.getElementById('tool-empty');
  const recentSection = document.getElementById('recent-section') as HTMLElement | null;
  const recentGrid = document.getElementById('recent-grid');

  let activeCat = 'all';
  let q = '';

  const tileOf = (slug: string) => document.querySelector<HTMLElement>(`.tool-tile[data-slug="${CSS.escape(slug)}"]`);

  const readRecent = (): string[] => {
    try {
      const raw = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
      return Array.isArray(raw) ? raw.filter((s): s is string => typeof s === 'string' && !!tileOf(s)) : [];
    } catch {
      return [];
    }
  };

  const renderRecent = () => {
    if (!recentGrid || !recentSection) return;
    const slugs = readRecent().slice(0, RECENT_MAX);
    // Solo tiene sentido como atajo: si no hay nada guardado, la sección no existe.
    if (!slugs.length) {
      recentSection.hidden = true;
      recentGrid.replaceChildren();
      return;
    }
    // Se clona la tarjeta ya renderizada para heredar el CSS scoped de Astro.
    recentGrid.replaceChildren(
      ...slugs.map((slug) => {
        const clone = tileOf(slug)!.cloneNode(true) as HTMLElement;
        clone.style.display = '';
        clone.removeAttribute('data-slug');
        return clone;
      }),
    );
    recentSection.hidden = false;
  };

  const apply = () => {
    let shown = 0;
    for (const section of sections) {
      const tiles = Array.from(section.querySelectorAll<HTMLElement>('.tool-tile'));
      let visibleHere = 0;
      for (const el of tiles) {
        const okCat = activeCat === 'all' || el.dataset.cat === activeCat;
        const okQ = !q || (el.dataset.search ?? '').includes(q);
        const show = okCat && okQ;
        el.style.display = show ? '' : 'none';
        if (show) visibleHere++;
      }
      section.hidden = visibleHere === 0;
      shown += visibleHere;
    }
    if (countEl) countEl.textContent = String(shown);
    if (emptyEl) emptyEl.style.display = shown ? 'none' : 'block';
    // Con filtro activo la fila de recientes estorba más de lo que ayuda.
    if (recentSection && !recentSection.hidden) recentSection.style.display = q || activeCat !== 'all' ? 'none' : '';
  };

  for (const c of chips) {
    c.addEventListener('click', () => {
      activeCat = c.dataset.cat ?? 'all';
      for (const x of chips) {
        const on = x === c;
        x.classList.toggle('is-active', on);
        x.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
      apply();
    });
  }

  search?.addEventListener('input', () => {
    q = (search.value || '').trim().toLowerCase();
    if (hint) hint.style.display = q ? 'none' : '';
    apply();
  });

  // "/" enfoca el buscador; Escape limpia y suelta el foco.
  document.addEventListener('keydown', (e) => {
    const target = e.target as HTMLElement | null;
    const typing = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
    if (e.key === '/' && !typing && !e.metaKey && !e.ctrlKey) {
      e.preventDefault();
      search?.focus();
      search?.select();
    } else if (e.key === 'Escape' && target === search && search) {
      search.value = '';
      q = '';
      if (hint) hint.style.display = '';
      apply();
      search.blur();
    }
  });

  document.getElementById('recent-clear')?.addEventListener('click', () => {
    localStorage.removeItem(RECENT_KEY);
    renderRecent();
    apply();
  });

  renderRecent();
  apply();
</script>
