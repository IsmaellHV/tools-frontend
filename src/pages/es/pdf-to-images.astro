---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolShell from '~/components/ToolShell.astro';
import PdfToImagesTool from '~/components/tools/PdfToImagesTool';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { buildDict } from '~/lib/dict';
import { buildToolJsonLd } from '~/lib/seo';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h1 = t('t.pdfToImages.title');
const lead = t('t.pdfToImages.lead');
const metaTitle = t('seo.pdfToImages.title');
const metaDesc = t('seo.pdfToImages.description');
const keywords = t('seo.pdfToImages.keywords');

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');
const url = `${SITE}${Astro.url.pathname.replace(/\/$/, '')}`;
const homePath = lang === 'en' ? withBase('/') : withBase('/es/');
const jsonLd = buildToolJsonLd({ name: h1, description: lead, url, lang, category: 'UtilitiesApplication' }, SITE, homePath);

const dict = buildDict(lang, [
  't.pdfToImages.drop',
  't.pdfToImages.total',
  't.pdfToImages.format',
  't.pdfToImages.rendering',
  't.pdfToImages.downloadAll',
  't.pdfToImages.downloadPage',
  't.pdfToImages.working',
  't.pdfToImages.page',
  't.pdfToImages.error',
] as const);
---

<BaseLayout title={metaTitle} description={metaDesc} {keywords} {jsonLd}>
  <ToolShell title={h1} {lead}>
    <PdfToImagesTool client:only="react" dict={dict} />
  </ToolShell>
</BaseLayout>
