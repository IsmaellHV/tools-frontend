---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolShell from '~/components/ToolShell.astro';
import ImagesToPdfTool from '~/components/tools/ImagesToPdfTool';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { buildDict } from '~/lib/dict';
import { buildToolJsonLd } from '~/lib/seo';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h1 = t('t.imagesToPdf.title');
const lead = t('t.imagesToPdf.lead');
const metaTitle = t('seo.imagesToPdf.title');
const metaDesc = t('seo.imagesToPdf.description');
const keywords = t('seo.imagesToPdf.keywords');

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');
const url = `${SITE}${Astro.url.pathname.replace(/\/$/, '')}`;
const homePath = lang === 'en' ? withBase('/') : withBase('/es/');
const jsonLd = buildToolJsonLd({ name: h1, description: lead, url, lang, category: 'UtilitiesApplication' }, SITE, homePath);

const dict = buildDict(lang, [
  't.imagesToPdf.drop',
  't.imagesToPdf.create',
  't.imagesToPdf.working',
  't.imagesToPdf.need1',
  't.imagesToPdf.remove',
  't.imagesToPdf.rotate',
  't.imagesToPdf.addMore',
  't.imagesToPdf.dragHint',
  't.imagesToPdf.error',
] as const);
---

<BaseLayout title={metaTitle} description={metaDesc} {keywords} {jsonLd}>
  <ToolShell title={h1} {lead}>
    <ImagesToPdfTool client:only="react" dict={dict} />
  </ToolShell>
</BaseLayout>
