---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolShell from '~/components/ToolShell.astro';
import QrReadTool from '~/components/tools/QrReadTool';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { buildDict } from '~/lib/dict';
import { buildToolJsonLd } from '~/lib/seo';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h1 = t('t.qrRead.title');
const lead = t('t.qrRead.lead');
const metaTitle = t('seo.qrRead.title');
const metaDesc = t('seo.qrRead.description');
const keywords = t('seo.qrRead.keywords');

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');
const url = `${SITE}${Astro.url.pathname.replace(/\/$/, '')}`;
const homePath = lang === 'en' ? withBase('/') : withBase('/es/');
const jsonLd = buildToolJsonLd({ name: h1, description: lead, url, lang }, SITE, homePath);

const dict = buildDict(lang, ['ui.copy', 'ui.copied', 'ui.copyFailed', 't.qrRead.drop', 't.qrRead.notFound', 't.qrRead.result'] as const);
---

<BaseLayout title={metaTitle} description={metaDesc} {keywords} {jsonLd}>
  <ToolShell title={h1} {lead}>
    <QrReadTool client:only="react" dict={dict} />
  </ToolShell>
</BaseLayout>
