---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { TOOLS, CATEGORIES, toolsByCategory } from '~/lib/tools';

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = t('home.metaTitle');
const description = t('home.metaDescription');
const keywords =
  lang === 'en'
    ? 'developer tools, online tools, base64, qr code, json viewer, json to excel, aes encrypt, jwt decoder, free dev utilities, in-browser tools'
    : 'herramientas desarrollo, utilidades online, base64, codigo qr, visor json, json a excel, cifrar aes, decodificador jwt, dev tools gratis';

const langPrefix = lang === 'en' ? '' : '/es';
const toolHref = (slug: string) => withBase(`${langPrefix}/${slug}`);
const toolUrl = (slug: string) => `${SITE}${toolHref(slug)}`;
const homeUrl = `${SITE}${withBase(langPrefix === '' ? '/' : '/es/')}`;

const catTitleOf = (id: string): string => {
  const c = CATEGORIES.find((x) => x.id === id);
  return c ? t(c.titleKey) : id;
};
const visibleCats = CATEGORIES.filter((c) => toolsByCategory(c.id).length > 0);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'DevTools',
    url: homeUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript and a modern browser',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
    inLanguage: lang,
    publisher: { '@type': 'Person', name: 'ismaelhv', url: 'https://ismaelhv.com' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: lang === 'es' ? 'Herramientas para desarrolladores' : 'Developer tools',
    numberOfItems: TOOLS.length,
    itemListElement: TOOLS.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t(tool.titleKey),
      description: t(tool.bodyKey),
      url: toolUrl(tool.slug),
    })),
  },
];
---

<BaseLayout {title} {description} {keywords} {jsonLd}>
  <section class="mb-10 grid gap-8 md:grid-cols-[1.5fr_1fr] md:items-center">
    <div>
      <p class="tag mb-4">// {String(TOOLS.length).padStart(2, '0')} TOOLS · v1.0</p>
      <h1 class="text-4xl leading-[0.95] md:text-6xl">
        {t('home.heroPre')}<br />
        <span style="background: var(--color-accent); color: var(--color-accent-fg); padding: 0 0.3em; display: inline-block">
          {t('home.heroAccent')}
        </span>{t('home.heroDot')}
      </h1>
      <p class="mt-5 max-w-xl text-base" style="color: var(--color-fg-muted)">
        {t('home.heroLead')}
      </p>
    </div>
    <div class="card" style="background: var(--color-bg-raised)">
      <p class="label">/* MANIFESTO */</p>
      <ul class="space-y-2 text-sm">
        <li>→ Runs 100% in your browser</li>
        <li>→ Zero uploads, zero tracking</li>
        <li>→ Open source, MIT licensed</li>
        <li>→ Bilingual (EN / ES)</li>
      </ul>
    </div>
  </section>

  <div class="divider"></div>

  <div class="mb-6 flex flex-col gap-4">
    <div class="flex items-stretch gap-3">
      <div style="position: relative; flex: 1; display: flex; align-items: center">
        <span aria-hidden="true" style="position: absolute; left: 0.7rem; color: var(--color-fg-muted); font-family: var(--font-mono); pointer-events: none">⌕</span>
        <input
          id="tool-search"
          type="search"
          autocomplete="off"
          placeholder={t('home.searchPlaceholder')}
          aria-label={t('home.searchPlaceholder')}
          style="padding-left: 2rem"
        />
      </div>
      <div class="tag" style="display: flex; align-items: center; white-space: nowrap">
        <span id="tool-count" style="color: var(--color-accent); font-weight: 700">{TOOLS.length}</span>&nbsp;/ {TOOLS.length} {t('home.toolsLabel')}
      </div>
    </div>

    <div id="tool-chips" class="flex flex-wrap gap-2">
      <button type="button" class="chip is-active" data-cat="all" aria-pressed="true">
        {t('home.filterAll')} <span class="chip-n">{TOOLS.length}</span>
      </button>
      {
        visibleCats.map((cat) => (
          <button type="button" class="chip" data-cat={cat.id} aria-pressed="false">
            {t(cat.titleKey)} <span class="chip-n">{toolsByCategory(cat.id).length}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div id="tool-grid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
    {
      TOOLS.map((tool) => {
        const name = t(tool.titleKey);
        const body = t(tool.bodyKey);
        const cat = catTitleOf(tool.category);
        return (
          <a
            href={toolHref(tool.slug)}
            class="tile group"
            data-cat={tool.category}
            data-search={`${name} ${tool.slug} ${body} ${cat}`.toLowerCase()}
          >
            <div class="mb-3 flex items-start justify-between">
              <span class="tag" style="background: var(--color-bg-raised)">{cat}</span>
              <span class="tag" style="background: var(--color-accent); color: var(--color-accent-fg); border-color: var(--color-border-strong)">
                {tool.icon}
              </span>
            </div>
            <h3 class="mb-1 text-lg">{name}</h3>
            <p class="text-sm" style="color: var(--color-fg-muted)">{body}</p>
            <p class="mt-3 font-mono text-xs" style="color: var(--color-accent)">→ /{tool.slug}</p>
          </a>
        );
      })
    }
  </div>

  <p id="tool-empty" class="mt-6 font-mono text-sm" style="display: none; color: var(--color-fg-muted)">// {t('home.noResults')}</p>
</BaseLayout>

<style>
  .chip {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.35rem 0.7rem;
    background: var(--color-bg-card);
    color: var(--color-fg);
    border: 2px solid var(--color-border-strong);
    border-radius: 0;
    cursor: pointer;
    transition: transform 0.08s ease;
  }
  .chip:hover {
    transform: translate(-2px, -2px);
  }
  .chip .chip-n {
    color: var(--color-fg-muted);
    margin-left: 0.2rem;
  }
  .chip.is-active {
    background: var(--color-accent);
    color: var(--color-accent-fg);
  }
  .chip.is-active .chip-n {
    color: var(--color-accent-fg);
  }
</style>

<script>
  const grid = document.getElementById('tool-grid');
  const tiles = Array.from(grid?.querySelectorAll<HTMLElement>('.tile') ?? []);
  const chips = Array.from(document.querySelectorAll<HTMLElement>('#tool-chips .chip'));
  const search = document.getElementById('tool-search') as HTMLInputElement | null;
  const countEl = document.getElementById('tool-count');
  const emptyEl = document.getElementById('tool-empty');

  let activeCat = 'all';
  let q = '';

  const apply = () => {
    let shown = 0;
    for (const el of tiles) {
      const okCat = activeCat === 'all' || el.dataset.cat === activeCat;
      const okQ = !q || (el.dataset.search ?? '').includes(q);
      const show = okCat && okQ;
      el.style.display = show ? '' : 'none';
      if (show) shown++;
    }
    if (countEl) countEl.textContent = String(shown);
    if (emptyEl) emptyEl.style.display = shown ? 'none' : 'block';
  };

  for (const c of chips) {
    c.addEventListener('click', () => {
      activeCat = c.dataset.cat ?? 'all';
      for (const x of chips) {
        const on = x === c;
        x.classList.toggle('is-active', on);
        x.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
      apply();
    });
  }

  search?.addEventListener('input', () => {
    q = (search.value || '').trim().toLowerCase();
    apply();
  });
</script>
