---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');
const url = `${SITE}${Astro.url.pathname.replace(/\/$/, '')}`;
const homeHref = lang === 'en' ? withBase('/') : withBase('/es/');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'DevTools', item: `${SITE}${homeHref}` },
    { '@type': 'ListItem', position: 2, name: t('about.title'), item: url },
  ],
};
---

<BaseLayout title={t('about.metaTitle')} description={t('about.metaDescription')} keywords={t('about.metaKeywords')} {jsonLd}>
  <article class="mx-auto max-w-2xl">
    <h1 class="mb-4 text-3xl font-bold" style="color: var(--color-fg)">{t('about.title')}</h1>
    <p class="mb-4" style="color: var(--color-fg-muted)">{t('about.body1')}</p>
    <p class="mb-8" style="color: var(--color-fg-muted)">{t('about.body2')}</p>

    <h2 class="mb-3 text-xl font-bold" style="color: var(--color-fg)">{t('about.authorTitle')}</h2>
    <p class="mb-4" style="color: var(--color-fg-muted)">{t('about.authorBody')}</p>

    <div class="mt-6 flex flex-wrap gap-3 text-sm">
      <a
        href="https://github.com/IsmaellHV/tools"
        rel="noopener"
        target="_blank"
        class="inline-flex items-center gap-2 rounded-md border px-3 py-2 no-underline"
        style="border-color: var(--color-border-strong); color: var(--color-fg)"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.78.62-3.37-1.36-3.37-1.36-.45-1.18-1.11-1.49-1.11-1.49-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.27 2.75 1.05A9.43 9.43 0 0 1 12 6.84c.85.004 1.71.12 2.51.34 1.91-1.32 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49C19.14 20.61 22 16.78 22 12.25 22 6.58 17.52 2 12 2z"/>
        </svg>
        {t('about.viewSource')}
      </a>
      <a
        href="https://ismaelhv.com"
        rel="noopener"
        target="_blank"
        class="inline-flex items-center gap-2 rounded-md border px-3 py-2 no-underline"
        style="border-color: var(--color-border-strong); color: var(--color-fg)"
      >
        {t('about.visitPortfolio')} ↗
      </a>
    </div>

    <p class="mt-8 text-sm" style="color: var(--color-fg-muted)">
      {t('about.madeBy')}
      <a href="https://ismaelhv.com" rel="noopener" target="_blank" style="color: var(--color-accent)">Ismael Hurtado Vargas</a>.
    </p>
  </article>
</BaseLayout>
