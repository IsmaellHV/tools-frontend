---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolShell from '~/components/ToolShell.astro';
import TextDiffTool from '~/components/tools/TextDiffTool';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { buildDict } from '~/lib/dict';
import { buildToolJsonLd } from '~/lib/seo';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h1 = t('t.textDiff.title');
const lead = t('t.textDiff.lead');
const metaTitle = t('seo.textDiff.title');
const metaDesc = t('seo.textDiff.description');
const keywords = t('seo.textDiff.keywords');

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');
const url = `${SITE}${Astro.url.pathname.replace(/\/$/, '')}`;
const homePath = lang === 'en' ? withBase('/') : withBase('/es/');
const jsonLd = buildToolJsonLd({ name: h1, description: lead, url, lang }, SITE, homePath);

const dict = buildDict(lang, [
  'ui.copy',
  'ui.copied',
  'ui.copyFailed',
  'ui.clear',
  't.textDiff.original',
  't.textDiff.changed',
  't.textDiff.placeholderA',
  't.textDiff.placeholderB',
  't.textDiff.lines',
  't.textDiff.viewSplit',
  't.textDiff.viewUnified',
  't.textDiff.swap',
  't.textDiff.ignoreCase',
  't.textDiff.ignoreWhitespace',
  't.textDiff.onlyDiff',
  't.textDiff.added',
  't.textDiff.removed',
  't.textDiff.modified',
  't.textDiff.same',
  't.textDiff.unchangedLine',
  't.textDiff.unchangedLines',
  't.textDiff.identical',
  't.textDiff.empty',
  't.textDiff.tooLarge',
] as const);
---

<BaseLayout title={metaTitle} description={metaDesc} {keywords} {jsonLd}>
  <ToolShell title={h1} {lead}>
    <TextDiffTool client:only="react" dict={dict} />
  </ToolShell>
</BaseLayout>
