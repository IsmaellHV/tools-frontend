---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolShell from '~/components/ToolShell.astro';
import QrGenTool from '~/components/tools/QrGenTool';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { buildDict } from '~/lib/dict';
import { buildToolJsonLd } from '~/lib/seo';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h1 = t('t.qrGen.title');
const lead = t('t.qrGen.lead');
const metaTitle = t('seo.qrGen.title');
const metaDesc = t('seo.qrGen.description');
const keywords = t('seo.qrGen.keywords');

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');
const url = `${SITE}${Astro.url.pathname.replace(/\/$/, '')}`;
const homePath = lang === 'en' ? withBase('/') : withBase('/es/');
const jsonLd = buildToolJsonLd({ name: h1, description: lead, url, lang }, SITE, homePath);

const dict = buildDict(lang, ['ui.input', 't.qrGen.placeholder', 't.qrGen.size', 't.qrGen.ec', 't.qrGen.downloadPng'] as const);
---

<BaseLayout title={metaTitle} description={metaDesc} {keywords} {jsonLd}>
  <ToolShell title={h1} {lead}>
    <QrGenTool client:only="react" dict={dict} />
  </ToolShell>
</BaseLayout>
