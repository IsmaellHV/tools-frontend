---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolShell from '~/components/ToolShell.astro';
import PasswordTool from '~/components/tools/PasswordTool';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { buildDict } from '~/lib/dict';
import { buildToolJsonLd } from '~/lib/seo';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const h1 = t('t.pwd.title');
const lead = t('t.pwd.lead');
const metaTitle = t('seo.pwd.title');
const metaDesc = t('seo.pwd.description');
const keywords = t('seo.pwd.keywords');

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');
const url = `${SITE}${Astro.url.pathname.replace(/\/$/, '')}`;
const homePath = lang === 'en' ? withBase('/') : withBase('/es/');
const jsonLd = buildToolJsonLd({ name: h1, description: lead, url, lang, category: 'SecurityApplication' }, SITE, homePath);

const dict = buildDict(lang, [
  'ui.copy',
  'ui.copied',
  'ui.copyFailed',
  't.pwd.intro',
  't.pwd.length',
  't.pwd.upper',
  't.pwd.lower',
  't.pwd.numbers',
  't.pwd.symbols',
  't.pwd.regenerate',
  't.pwd.copy',
  't.pwd.charsUsed',
  't.pwd.errNoChars',
  't.pwd.strength.veryWeak',
  't.pwd.strength.weak',
  't.pwd.strength.fair',
  't.pwd.strength.strong',
  't.pwd.strength.veryStrong',
] as const);
---

<BaseLayout title={metaTitle} description={metaDesc} {keywords} {jsonLd}>
  <ToolShell title={h1} {lead}>
    <PasswordTool client:only="react" dict={dict} />
  </ToolShell>
</BaseLayout>
