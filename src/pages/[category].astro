---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ToolCard from '~/components/ToolCard.astro';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { CATEGORIES, toolsByCategory, type ToolCategory } from '~/lib/tools';
import type { UIKey } from '~/i18n/ui';

// Una sola plantilla genera las 7 páginas de categoría por idioma.
export function getStaticPaths() {
  return CATEGORIES.filter((c) => toolsByCategory(c.id).length > 0).map((c) => ({
    params: { category: c.id },
    props: { catId: c.id },
  }));
}

const { catId } = Astro.props as { catId: ToolCategory };
const cat = CATEGORIES.find((c) => c.id === catId)!;
const tools = toolsByCategory(catId);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const title = t(`seo.cat.${catId}.title` as UIKey);
const description = t(`seo.cat.${catId}.description` as UIKey);
const keywords = t(`seo.cat.${catId}.keywords` as UIKey);
const intro = t(`cat.${catId}.intro` as UIKey);
const h1 = t(cat.titleKey);

const SITE = (import.meta.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://ismaelhv.com').replace(/\/$/, '');
const langPrefix = lang === 'en' ? '' : '/es';
const homeHref = withBase(langPrefix === '' ? '/' : '/es/');
const toolHref = (slug: string) => withBase(`${langPrefix}/${slug}`);
const catHref = (id: string) => withBase(`${langPrefix}/${id}`);
const url = `${SITE}${Astro.url.pathname.replace(/\/$/, '')}`;

const others = CATEGORIES.filter((c) => c.id !== catId && toolsByCategory(c.id).length > 0);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: h1,
    description,
    url,
    inLanguage: lang,
    isPartOf: { '@type': 'WebSite', name: 'DevTools', url: `${SITE}${homeHref}` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: h1,
    numberOfItems: tools.length,
    itemListElement: tools.map((tool, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: t(tool.titleKey),
      description: t(tool.bodyKey),
      url: `${SITE}${toolHref(tool.slug)}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: lang === 'es' ? 'Herramientas' : 'Tools', item: `${SITE}${homeHref}` },
      { '@type': 'ListItem', position: 2, name: h1, item: url },
    ],
  },
];
---

<BaseLayout {title} {description} {keywords} {jsonLd}>
  <section>
    <a href={homeHref} class="tag mb-4 inline-block" style="text-decoration: none">← {t('cat.backHome')}</a>

    <header class="mb-6" style="border-bottom: 4px solid var(--color-border-strong); padding-bottom: 1.5rem">
      <h1 class="text-4xl md:text-5xl">{h1}</h1>
      <p class="mt-3 max-w-2xl text-base md:text-lg" style="color: var(--color-fg-muted)">{t(cat.bodyKey)}</p>
      <span class="tag mt-4 inline-block">
        {tools.length}
        {t('cat.toolCount')}
      </span>
    </header>

    <div class="tool-grid mb-8">
      {
        tools.map((tool) => (
          <ToolCard
            slug={tool.slug}
            href={toolHref(tool.slug)}
            name={t(tool.titleKey)}
            body={t(tool.bodyKey)}
            cat={h1}
            catId={catId}
          />
        ))
      }
    </div>

    <p class="mb-8 max-w-3xl text-sm" style="color: var(--color-fg-muted)">{intro}</p>

    <div class="sec-head">
      <h2 class="label" style="margin-bottom: 0">// {t('cat.otherCats')}</h2>
    </div>
    <div class="flex flex-wrap gap-2">
      {
        others.map((c) => (
          <a class="tag" href={catHref(c.id)} style="text-decoration: none">
            {t(c.titleKey)} · {toolsByCategory(c.id).length}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
