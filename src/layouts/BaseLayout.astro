---
import SEO from '~/components/SEO.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';
import LangSwitcher from '~/components/LangSwitcher.astro';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import '~/styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  keywords?: string;
}

const { title, description, canonical, ogImage, noindex, jsonLd, keywords } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'en' ? withBase('/') : withBase('/es/');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;800;900&family=JetBrains+Mono:wght@400;600&display=swap"
    />
    <SEO {title} {description} {canonical} {ogImage} {noindex} {jsonLd} {keywords} />

    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('tools_theme');
          const prefers = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.dataset.theme = stored || prefers;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
  </head>
  <body>
    <header style="border-bottom: 4px solid var(--color-border-strong); background: var(--color-bg)">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4">
        <a href={homeHref} class="wordmark" style="text-decoration: none">
          <span class="badge">DEV</span>
          <span>TOOLS<span style="color: var(--color-accent)">/</span></span>
        </a>
        <div class="flex items-center gap-4">
          <a href="https://github.com/IsmaellHV/tools" rel="noopener" target="_blank" class="tag">
            {t('nav.github')} ↗
          </a>
          <LangSwitcher />
          <ThemeToggle label={t('nav.toggleTheme')} />
        </div>
      </nav>
    </header>

    <main class="mx-auto max-w-6xl px-5 py-12">
      <slot />
    </main>

    <footer style="border-top: 4px solid var(--color-border-strong); background: var(--color-bg-card)">
      <div class="mx-auto flex max-w-6xl flex-col items-start gap-2 px-5 py-6 text-sm sm:flex-row sm:items-center sm:justify-between">
        <p style="color: var(--color-fg)">
          <strong>{t('footer.tagline')}</strong>
        </p>
        <p style="color: var(--color-fg-muted)">
          {t('footer.privacy')} · &copy; {new Date().getFullYear()} ismaelhv
        </p>
      </div>
    </footer>
  </body>
</html>
