---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  id="theme-toggle"
  type="button"
  aria-label={label}
  title={label}
  class="inline-flex h-9 w-9 items-center justify-center text-base"
  style="border: 2px solid var(--color-border-strong); color: var(--color-fg); background: var(--color-bg-card); border-radius: 0"
>
  <span data-theme-icon-dark aria-hidden="true">🌙</span>
  <span data-theme-icon-light aria-hidden="true" hidden>☀️</span>
</button>

<script is:inline>
  (() => {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    const dark = btn.querySelector('[data-theme-icon-dark]');
    const light = btn.querySelector('[data-theme-icon-light]');
    const sync = () => {
      const isDark = document.documentElement.dataset.theme === 'dark';
      dark.hidden = isDark;
      light.hidden = !isDark;
    };
    sync();
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('tools_theme', next);
      } catch {
        /* localStorage unavailable (private mode / quota) — ignore */
      }
      sync();
    });
  })();
</script>
