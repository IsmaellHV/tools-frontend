---
// Iconos de línea propios: 24x24, trazo 2, sin relleno, geometría simple para que
// se lean bien a 20px dentro del cuadro de la tarjeta.
interface Props {
  slug: string;
  size?: number;
}

const { slug, size = 20 } = Astro.props;

const ICONS: Record<string, string> = {
  // Encoding
  base64: '<path d="m9 6-5 6 5 6"/><path d="m15 6 5 6-5 6"/>',
  'base64-image':
    '<rect x="2" y="6" width="12" height="10" rx="1"/><circle cx="5.5" cy="9.5" r="1"/><path d="m2 14 4-3 3.5 2.5"/><path d="M16 11h6"/><path d="m19.5 8.5 2.5 2.5-2.5 2.5"/>',
  jwt: '<rect x="3" y="7" width="18" height="10" rx="1"/><path d="M9 7v10M15 7v10"/>',

  // Security
  aes: '<rect x="4" y="10" width="16" height="11" rx="1"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>',
  password: '<circle cx="7" cy="16" r="3.5"/><path d="m9.5 13.5 9-9"/><path d="m15.5 7.5 2 2"/><path d="m18 5 2 2"/>',

  // QR
  'qr-read':
    '<rect x="3" y="3" width="6" height="6"/><rect x="15" y="3" width="6" height="6"/><rect x="3" y="15" width="6" height="6"/><path d="M18 14v6"/><path d="m15.5 17.5 2.5 2.5 2.5-2.5"/>',
  'qr-generate':
    '<rect x="3" y="3" width="6" height="6"/><rect x="15" y="3" width="6" height="6"/><rect x="3" y="15" width="6" height="6"/><path d="M18 20v-6"/><path d="m15.5 16.5 2.5-2.5 2.5 2.5"/>',

  // Data
  json: '<path d="M9 4H8a3 3 0 0 0-3 3v2a3 3 0 0 1-3 3 3 3 0 0 1 3 3v2a3 3 0 0 0 3 3h1"/><path d="M15 4h1a3 3 0 0 1 3 3v2a3 3 0 0 0 3 3 3 3 0 0 0-3 3v2a3 3 0 0 1-3 3h-1"/>',
  'json-excel': '<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M3 9h18"/><path d="M9 9v11"/><path d="M15 9v11"/>',

  // Text
  'text-diff':
    '<rect x="3" y="4" width="7" height="16" rx="1"/><rect x="14" y="4" width="7" height="16" rx="1"/><path d="M5 12h3"/><path d="M17.5 10.5v3"/><path d="M16 12h3"/>',

  // PDF
  'pdf-merge': '<rect x="3" y="3" width="10" height="13" rx="1"/><rect x="11" y="8" width="10" height="13" rx="1"/>',
  'pdf-split': '<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M4 12h16" stroke-dasharray="3 3"/>',
  'images-to-pdf':
    '<rect x="4" y="3" width="16" height="18" rx="1"/><circle cx="9" cy="9" r="1.5"/><path d="m6.5 17 4-4 3 2.5 2-1.5 2 2"/>',
  'pdf-rotate': '<path d="M20.5 9A8.5 8.5 0 1 0 21 14"/><path d="M21 4v5h-5"/>',
  'pdf-to-images':
    '<rect x="3" y="7" width="13" height="12" rx="1"/><path d="M8 4h11a2 2 0 0 1 2 2v10"/><path d="m3 17 4-3.5 3 2.5 2.5-2 3.5 3"/>',
  'pdf-compress': '<path d="M12 3v9"/><path d="m8 8 4 4 4-4"/><path d="M4 20h16"/>',
  'pdf-page-numbers': '<rect x="4" y="3" width="16" height="18" rx="1"/><path d="M8 8h8"/><path d="M8 12h8"/><path d="M14 17h2"/>',
  'pdf-image':
    '<rect x="3" y="4" width="18" height="16" rx="1"/><circle cx="8.5" cy="9" r="1.5"/><path d="m4 17 4.5-4 3 2.5"/><rect x="13" y="12" width="7" height="6" rx="1"/><path d="M20 18v3M18.5 19.5h3" stroke-width="1.6"/>',

  // Image
  'image-compress':
    '<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M12 8v4"/><path d="m9.5 9.5 2.5 2.5 2.5-2.5"/><path d="M8 16h8"/>',
  'image-convert': '<path d="M4 9h14"/><path d="m15 6 3 3-3 3"/><path d="M20 15H6"/><path d="m9 12-3 3 3 3"/>',
  'image-resize': '<rect x="3" y="3" width="18" height="18" rx="1"/><path d="m8 16 8-8"/><path d="M16 12V8h-4"/><path d="M8 12v4h4"/>',
};

// Cualquier slug sin icono propio cae en un cuadro neutro en vez de romper la tarjeta.
const inner = ICONS[slug] ?? '<rect x="4" y="4" width="16" height="16" rx="1"/>';
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
/>
