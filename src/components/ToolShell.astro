---
import CaptchaGate from '~/components/CaptchaGate.tsx';
import { getLangFromUrl, useTranslations, withBase } from '~/i18n/utils';
import { buildDict } from '~/lib/dict';
import { CATEGORIES, TOOLS } from '~/lib/tools';

interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'en' ? withBase('/') : withBase('/es/');

// Enlace a la categoría de esta herramienta, deducido del slug de la URL.
const slug = Astro.url.pathname.replace(/\/$/, '').split('/').pop() ?? '';
const tool = TOOLS.find((x) => x.slug === slug);
const cat = tool ? CATEGORIES.find((c) => c.id === tool.category) : undefined;
const catHref = cat ? withBase(`${lang === 'en' ? '' : '/es'}/${cat.id}`) : '';

const SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';

const gateDict = buildDict(lang, ['gate.title', 'gate.body', 'gate.unlocked', 'gate.failed', 'gate.retry'] as const);
---

<section>
  <nav class="mb-4 flex flex-wrap items-center gap-2">
    <a href={homeHref} class="tag" style="text-decoration: none">← {t('nav.home')}</a>
    {
      cat && (
        <a href={catHref} class="tag" style="text-decoration: none">
          {t(cat.titleKey)}
        </a>
      )
    }
  </nav>

  <header class="mb-8" style="border-bottom: 4px solid var(--color-border-strong); padding-bottom: 1.5rem">
    <h1 class="text-4xl md:text-5xl">{title}</h1>
    {
      lead && (
        <p class="mt-3 max-w-2xl text-base md:text-lg" style="color: var(--color-fg-muted)">
          {lead}
        </p>
      )
    }
    <span
      class="tag mt-4"
      style="display: inline-flex; align-items: center; gap: 6px; border-color: var(--color-accent); color: var(--color-accent); font-weight: 700"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="4" y="10" width="16" height="11" rx="1" />
        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
      </svg>
      {t('shell.local')}
    </span>
  </header>

  <CaptchaGate siteKey={SITE_KEY} dict={gateDict} client:only="react">
    <slot />
  </CaptchaGate>
</section>

<span class="sr-only">{t('nav.toggleLang')}</span>

<script>
  // Registra la herramienta visitada para la fila "usadas recientemente" del home.
  // Solo guarda slugs, en este navegador; nada sale de la página.
  const RECENT_KEY = 'tools_recent';
  const RECENT_MAX = 8;
  const slug = window.location.pathname.replace(/\/$/, '').split('/').pop();

  if (slug) {
    try {
      const raw = JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
      const prev: string[] = Array.isArray(raw) ? raw.filter((s: unknown): s is string => typeof s === 'string') : [];
      localStorage.setItem(RECENT_KEY, JSON.stringify([slug, ...prev.filter((s) => s !== slug)].slice(0, RECENT_MAX)));
    } catch {
      // localStorage bloqueado (modo privado / cookies off): la home simplemente no mostrará recientes.
    }
  }
</script>
